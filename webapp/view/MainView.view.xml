    <f:DynamicPage
        id="dynamicPageId"
        showFooter="true"
        headerExpanded="{/headerExpanded}"
    >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Pre-Registro de Facturas" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <!-- <HBox class="contentMessagetrip"> -->
                <MessageStrip
                    text="{path: 'localModel>/lineaMensaje'}"
                    type="Success"
                    showIcon="true"
                    showCloseButton="true"
                    class="messagetrip"
                    id="msgStrip"
                    visible="{path: 'localModel>/bValidLineaMensaje'}"
                />
                <!-- </HBox> -->
                <layout:HorizontalLayout
                    allowWrapping="true"
                    visible="{localModel>/ProveedorSeleccionadoVisible}"
                >
                    <layout:VerticalLayout class="datos">
                        <!-- <ObjectAttribute class="texto-header" title="Nombre" text="{localModel>/ProveedorSeleccionado/nombre}"/>
                        <ObjectAttribute class="texto-header" title="Razón Social" text="{localModel>/ProveedorSeleccionado/razonSocial}" />
                        <ObjectAttribute class="texto-header" title="RUC" text="{localModel>/ProveedorSeleccionado/usuario}" active="true" /> -->
                        <ObjectAttribute
                            class="texto-header"
                            title="Nombre"
                            text="{localModel>/ProveedorSeleccionado/NOMBRE}"
                        />
                        <ObjectAttribute
                            class="texto-header"
                            title="Razón Social"
                            text="{localModel>/ProveedorSeleccionado/RAZON_SOCIAL}"
                        />
                        <ObjectAttribute
                            class="texto-header"
                            title="RUC"
                            text="{localModel>/ProveedorSeleccionado/USUARIO}"
                            active="true"
                        />
                    </layout:VerticalLayout>
                    <ToolbarSpacer />
                </layout:HorizontalLayout>
                <f:content>
                    <fb:FilterBar
                        reset="onLimpiarFiltros"
                        clear="onLimpiarFiltros"
                        search="onSearch"
                        useToolbar="false"
                        showGoOnFB="true"
                        showAllFilters="true"
                        showClearOnFB="false"
                        showFilterConfiguration="true"
                        showRestoreButton="true"
                        showRestoreOnFB="true"
                        id="filterbar"
                        persistencyKey="myPersKey"
                        filterChange=".onFilterChange"
                        afterVariantLoad=".onAfterVariantLoad"
                    >
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                name="Sociedad"
                                label="Sociedad"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <ComboBox
                                        placeholder="Sociedad"
                                        id="cbSociedad"
                                        width="100%"
                                        items="{
                                                path: 'modelSociedadesGlobalCompras>/listSocieties'
                                            }"
                                        selectedKey="{
                                                path: 'localModel>/filtrosSociedad'
                                            }"
                                        selectionChange="onChangeSociedad"
                                        required="true"
                                    >
                                        <core:Item
                                            key="{modelSociedadesGlobalCompras>cod}"
                                            text="{modelSociedadesGlobalCompras>name}"
                                        />
                                    </ComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem
                                name="Proveedor"
                                label="Proveedor"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <Input
                                        id="proveedorInput"
                                        enabled="false"
                                        required="true"
                                        placeholder="Seleccione proveedor"
                                        valueHelpOnly="true"
                                        showValueHelp="true"
                                        valueHelpRequest="onValueHelpRequest"
                                        width="auto"
                                        value="{localModel>/ProveedorSeleccionado/razonSocial}"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>

                            <!-- <fb:FilterGroupItem name="a" label="Sociedad" visibleInFilterBar="true" groupName="Group1">
                                <fb:control>
                                    <ComboBox placeholder="Seleccione"
                                    enabled = "{localModel>/bEnabledSociedadEncontrada}"
                                            id = "cbSociedad" width="15em" items="{
                                                path: 'localModel>/listaSociedad',
                                                sorter: { path: 'Name' }
                                                
                                            }" required="true" selectedKey="{
                                                path: 'localModel>/filtrosSociedad'
                                            }" selectionChange="onChangeSociedad">
                                        <core:Item key="{localModel>key}" text="{localModel>text}"/>
                                    </ComboBox>
                                </fb:control>
                            </fb:FilterGroupItem> -->

                            <fb:FilterGroupItem
                                name="b"
                                label="Fecha Inicio de Compras"
                                visibleInFilterBar="true"
                                groupName="Group1"
                            >
                                <fb:control>
                                    <!-- <DatePicker id="idDatePickerInicioCompras" placeholder="Ingrese Fecha Inicio Compras" change="onSelectChange" valueFormat="dd/MM/yyyy" displayFormat="dd/MM/yyyy" value="{path:'localModel>/filtros/fFechaEmision'}" textAlign="End" /> -->
                                    <DatePicker
                                        id="idDatePickerInicioCompras"
                                        placeholder="Ingrese Fecha Inicio Compras"
                                        change="onSelectChange"
                                        valueFormat="dd/MM/yyyy"
                                        displayFormat="dd/MM/yyyy"
                                        value="{
											path: 'localModel>/filtros/fFechaEmision'
										}"
                                        required="true"
                                        maxDate="{
											path: 'localModel>/maxDateFechaHasta'
										}"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem
                                name="c"
                                label="Fecha Fin de Compras"
                                visibleInFilterBar="true"
                                groupName="Group1"
                            >
                                <fb:control>
                                    <!-- <DatePicker id="idDatePickerFinCompras" placeholder="Ingrese Fecha Fin Compras" change="onSelectChange" valueFormat="dd/MM/yyyy" displayFormat="dd/MM/yyyy" value="{path:'localModel>/filtros/fFechamasuno'}" textAlign="End"/> -->
                                    <DatePicker
                                        id="idDatePickerFinCompras"
                                        placeholder="Ingrese Fecha Fin Compras"
                                        change="onSelectChange"
                                        valueFormat="dd/MM/yyyy"
                                        displayFormat="dd/MM/yyyy"
                                        value="{
											path: 'localModel>/filtros/fFechamasuno'
										}"
                                        required="true"
                                        maxDate="{
											path: 'localModel>/maxDateFechaHasta'
										}"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem
                                name="d"
                                label="Estado"
                                visibleInFilterBar="true"
                                groupName="Group1"
                            >
                                <fb:control>
                                    <MultiComboBox
                                        placeholder="Seleccione"
                                        enabled="false"
                                        id="mcRolMainView2"
                                        width="15em"
                                        showSelectAll="true"
                                        items="{
                                                path: 'localModel>/listaMultipleEstadoRegistro',
                                                sorter: { path: 'Name' }
                                            }"
                                        selectedKeys="{
                                                path: 'localModel>/filtrosEstadoRegistro'
                                            }"
                                        selectionChange="onEstadoCambio"
                                    >
                                        <core:Item
                                            key="{localModel>key}"
                                            text="{localModel>text}"
                                        />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
