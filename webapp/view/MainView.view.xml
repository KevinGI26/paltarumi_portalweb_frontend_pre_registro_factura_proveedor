                 <layout:VerticalLayout class="dato">
          <Title text="Total Documentos ({= ${localModel>/ListaComprobantes}.length })" level="H2"/>
                            <ToolbarSpacer/>
                            <SearchField enableSuggestions="true" id="search" placeholder="Buscar Documento...." width="200%" class="search" liveChange="onLiveChangeBusqueda" value="{
                                            path : 'localModel>/search'}"/>
                 </layout:VerticalLayout>
        </f:content > -->
