                                />
                                <Text
                                    text="{localModel>FECHA_RECHAZO}"
                                    width="auto"
                                    maxLines="1"
                                    wrapping="false"
                                    textAlign="Begin"
                                    textDirection="Inherit"
                                />
                                <Link
                                    text="Historial Rechazo"
                                    textAlign="Center"
                                    press="onShowHistorialRechazoPreFact"
                                    width="auto"
                                    target="_blank"
                                    wrapping="false"
                                    enabled="true"
                                    visible="{localModel>visibleHistorial}"
                                    emphasized="false"
                                    subtle="false"
                                />
                                <!--<Text text="{localModel>DOCUMENTO_SAP}" width="auto" maxLines="1" wrapping="false" textAlign="Begin" textDirection="Inherit"/>-->
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ScrollContainer>
        </f:content>
        <f:content />

        <f:footer>
            <OverflowToolbar id="otbFooter">
                <!-- <Button type="Accept" text="Buzón" press="onAbrirBuzón" visible="{localModel>/tieneCorreos}">
					<layoutData><OverflowToolbarLayoutData priority="NeverOverflow" /></layoutData>
				</Button> -->
                <Button
                    type="Reject"
                    text="Cerrar"
                    visible="false"
                >
                    <layoutData>
                        <OverflowToolbarLayoutData priority="NeverOverflow" />
                    </layoutData>
                </Button>

                <!-- </OverflowToolbar> -->

                <!-- <OverflowToolbar id="otbFooter" > -->
                <ToolbarSpacer />
                <Button
                    type="Transparent"
                    text="TEST"
                    icon="sap-icon://receipt"
                    press="onTestPP"
                    visible="false"
                />
                <Button
                    type="Transparent"
                    text="Guardar Factura"
                    icon="sap-icon://receipt"
                    press="onCrearPreFactura"
                />
                <Button
                    type="Transparent"
                    text="Exportar datos"
                    icon="sap-icon://documents"
                    press="exportarExcel"
                />
                <!-- <Button type="Transparent" text="Configuración" icon="sap-icon://action-settings" press="onConfigurarColumnas"/> -->
                <Button
                    type="Transparent"
                    text="Configuración"
                    icon="sap-icon://action-settings"
                    press="onConfigurarColumnasMejorado"
                />
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
