	<Dialog id="dialogAgregarPreFacturaPeru" title="Pre Registro Factura Peru" icon="sap-icon://sales-order" titleAlignment="Center" class = "portalScope">
		<content>
			<VBox class="sapUiSmallMargin">
				<f:SimpleForm editable="true" layout="ColumnLayout" columnsM="1" columnsL="2" columnsXL="2">
					<f:content>

						<Label text="Nro. Serie / Correlativo" />
						<Input onkeyup="this.value = this.value.toUpperCase();" required="true" valueLiveUpdate="true" fieldGroupIds="onOpenAddInput" 
						type="Text" valueState="None" showValueHelp="false" app:zeroPad="{localModel>/LONGSERIE}" textAlign="Right" value="{localModel>/preRegistro/NRO_SERIE}" 
						editable="{localModel>/preRegistro/Editable}" enabled="true" visible="true" width="auto" valueHelpOnly="true" 
						maxLength="{localModel>/LONGSERIE}" id="NRO_SERIE" change="onInputChangeNroSerie" />

						<Input valueLiveUpdate="true" required="true" fieldGroupIds="onOpenAddInput" type="Text" showValueHelp="false" 
						app:zeroPad="{localModel>/LONGCORRELATIVO}" value="{localModel>/preRegistro/NRO_COMPROBANTE}" enabled="true" 
						editable="{localModel>/preRegistro/Editable}" visible="true" width="auto" valueHelpOnly="true" maxLength="{localModel>/LONGCORRELATIVO}"
						id="COMPROBANTE" change="onInputChangeCorrelativo" />
						<Label text="Fecha de Cont. Factura" />
						<!-- <Input id="txtfechacontPeru" value="{path:'localModel>/datosCabecera/sFechaContable'}" textAlign="End" enabled="false"/> -->

						<DatePicker textAlign="Right" dateValue="{path: 'localModel>/preRegistro/FECHA_BASE'}" change="handleChangeinicial" id="FECHA_BASE" displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy" editable="false"/>
						<Label text="Fecha Emisión" />
						<DatePicker required="true" editable="{localModel>/preRegistro/Editable}" textAlign="Right" dateValue="{path: 'localModel>/preRegistro/FECHA_EMISION'}" change="handleChangeinicial" id="FECHA_EMISION" displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy"/>
						<Label text="Importe + Igv" />
						<Input value="{path: 'localModel>/preRegistro/IMPORTE' , formatter: '.formatter.formatoMoneda'}" change="onChangeImporte" id="IMPORTE" type="Text" showValueHelp="false" editable="false" enabled="true" visible="true" textAlign="Right" width="auto" valueHelpOnly="false" maxLength="0"/>
						<Input value="{localModel>/preRegistro/MONEDA}" type="Text" showValueHelp="false" editable="false" enabled="true" visible="true" width="auto" valueHelpOnly="false" maxLength="0"/>
						
						
						<Label text="Clase de Documento" />
						<Select id="ncboClaseDocumento" forceSelection="true" change="onSelectChange" items="{
                                path:'localModel>/comboClaseDocumento' 
                            }" enabled="false" selectedKey="{
                            path: 'localModel>/selectClaseDocumento'
                            }">
							<c:Item key="{localModel>id}" text="{localModel>name}" enabled="{= ${localModel>id} === '0' ? false : true }"></c:Item>
						</Select>
						<Label text="Condición de Pago" />
						<Input value="{localModel>/preRegistro/CONDICIONPAGO} {localModel>/preRegistro/DESCRIPCION_CONDICION_PAGO}" id="CONDICIONPAGO" type="Text" showValueHelp="false" editable="false" textAlign="Left" enabled="true" visible="true" width="auto" valueHelpOnly="false" maxLength="0"/>
						<!-- <Label text="Indicador de Impuesto" />

						<ComboBox items="{ path: 'localModel>/ListaImpuestos' }" selectedKey="{localModel>/preRegistro/TIPO_IMPUESTO}" id="cboTipoImpuesto" selectionChange="onChangeCboImporte" editable="false" enabled="true" visible="true" width="auto" valueState="None" maxWidth="100%">
							<items>
								<c:Item key="{localModel>key}" text="{localModel>key} - {localModel>text}"/>
							</items>
						</ComboBox> -->

						<Label text="Detracción" />

						<ComboBox 
						editable = "{localModel>/preRegistro/EDITABLE_DETRACCION}"
						 enabled="true" placeholder="Seleccione el tipo detracción" visible="true" width="auto" valueState="None" maxWidth="100%" items="{ path: 'localModel>/ListaDetracciones'}"  selectedKey="{localModel>/preRegistro/TIPO_DETRACCION}" change="fnChanceTipoDetraccion" id="cboDetraccion">
							<items>
								<c:Item key="{localModel>key}" text="{localModel>text}" enabled="true"/>
							</items>
						</ComboBox>

						<Label text="Impuesto" />
						<Input value="{path: 'localModel>/preRegistro/IMPUESTOIMPORTE' , formatter: '.formatter.formatoMoneda'}" id="IMPUESTOIMPORTE" change="onChangeImporte" type="Text" showValueHelp="false" editable="false" textAlign="Right" enabled="true" visible="true" width="auto" valueHelpOnly="false" maxLength="0"/>
						<Input value="{localModel>/preRegistro/MONEDA}" type="Text" showValueHelp="false" editable="false" enabled="true" visible="true" width="auto" valueHelpOnly="false" maxLength="0"/>

						
						<!-- <Select id="slDetraccionPeru" forceSelection="true" change="onSelectChange" items="{
                                path:'localModel>/comboDetraccion'
                            }" selectedKey="{
                            path: 'localModel>/selectDetraccion'
                            }">
                                <c:Item key="{localModel>id}" text="{localModel>name}" enabled="{= ${localModel>id} === '0' ? false : true }"></c:Item>
                        </Select> -->

					</f:content>
				</f:SimpleForm>
			</VBox>
