												selectedKey="{
												path: 'localModel>selectClaseDoc'
												}"
												enabled="{
												path: 'localModel>enabledSelectClaseDoc'
												}"
												>
										<c:Item key="{localModel>key}" text="{localModel>text}" ></c:Item>
										</Select>
										<ObjectNumber number="{localModel>tipoArchivoDocPrueba}" unit="" emphasized="true" state="None"/>
										<Text text="{localModel>sizeArchivoDoc} Kb" width="auto" maxLines="1" wrapping="false" textAlign="Begin" textDirection="Inherit"/>
										<Link text="Eliminar" textAlign="Begin" press="onpressEliminarDocs" width="auto" target="_blank" wrapping="false" enabled="true" visible="true" emphasized="false" subtle="false"/>
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</content>
		<footer>
			<Toolbar>
				<content>
					<ToolbarSpacer />
					<Button icon="sap-icon://save" text="Guardar Factura" press="onPressGenerarRegistroFactura" type="Emphasized" />
					<Button text="Cerrar" icon="sap-icon://close-command-field" press="onCloseCrearPreFacturaPeru" ariaHasPopup="Dialog" />
				</content>
			</Toolbar>
		</footer>
	</Dialog>
</c:FragmentDefinition>