<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		id="idCentroCosto"
		title="Proveedores"
		items="{path: 'localModel>/listaUsuarios'}"
		search="onSearchUsuarioPaginado"
		confirm="onValueHelpConfirm"
		cancel="onValueHelpCancel"
        contentHeight="auto"
		growing="true"
        growingThreshold="{path: 'localModel>/growingThresholdTable'}"
        updateStarted="updateStartedListUserPagination">
		<StandardListItem
			id="idListCentroCosto"
			iconDensityAware="false"
			iconInset="false"
			title="{localModel>razonSocial}"
			description="{localModel>usuario}" />
	</SelectDialog>
</core:FragmentDefinition>